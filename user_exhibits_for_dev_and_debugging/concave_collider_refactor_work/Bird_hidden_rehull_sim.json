{
  "title": "1D Collision Lab",
  "description": "Two carts move toward each other on a frictionless track. Adjust initial velocities to explore elastic and inelastic collisions and observe positions and velocities over time.",
  "environment": {
    "walls": [
      "left",
      "right",
      "bottom"
    ],
    "gravity": 0,
    "unit": "m",
    "physicsEngine": "planck",
    "pixelsPerUnit": 22.22222222222222
  },
  "objects": [
    {
      "id": "cart_a",
      "x": 15.916147186062801,
      "y": 4.984066121892406,
      "width": 10.779754699274035,
      "height": 9.932206300375132,
      "svg": "bird",
      "velocity": {
        "x": 5,
        "y": 0
      },
      "mass": 3,
      "restitution": 0.8,
      "friction": 0,
      "isStatic": false,
      "inertia": 10000000000,
      "showVectors": [
        "velocity"
      ]
    },
    {
      "id": "cart_b",
      "x": 8.577227857512899,
      "y": 2.5241976804836317,
      "width": 2.7,
      "height": 1.2,
      "svg": "dynamics_cart",
      "velocity": {
        "x": -5,
        "y": 0
      },
      "mass": 3,
      "restitution": 0.8,
      "friction": 0,
      "isStatic": false,
      "inertia": 10000000000,
      "showVectors": [
        "velocity"
      ]
    }
  ],
  "controls": [
    {
      "type": "slider",
      "label": "Cart A Initial Velocity (m/s)",
      "targetObj": "cart_a",
      "property": "velocity.x",
      "min": -30,
      "max": 30,
      "step": 0.1,
      "defaultValue": 5
    },
    {
      "type": "slider",
      "label": "Cart B Initial Velocity (m/s)",
      "targetObj": "cart_b",
      "property": "velocity.x",
      "min": -30,
      "max": 30,
      "step": 0.1,
      "defaultValue": -5
    }
  ],
  "outputs": [
    {
      "title": "Cart outputs",
      "values": [
        {
          "label": "Cart A Velocity (x)",
          "targetObj": "cart_a",
          "property": "velocity.x",
          "unit": "m/s"
        },
        {
          "label": "Cart A Position (x)",
          "targetObj": "cart_a",
          "property": "position.x",
          "unit": "m"
        },
        {
          "label": "Cart B Velocity (x)",
          "targetObj": "cart_b",
          "property": "velocity.x",
          "unit": "m/s"
        },
        {
          "label": "Cart B Position (x)",
          "targetObj": "cart_b",
          "property": "position.x",
          "unit": "m"
        }
      ]
    }
  ],
  "graphs": [
    {
      "type": "line",
      "title": "Horizontal Velocity vs Time",
      "yAxisRange": {
        "min": -12,
        "max": 12
      },
      "yAxisLabel": "Velocity (m/s)",
      "lines": [
        {
          "label": "Cart A Velocity X",
          "color": "#ff6bff",
          "targetObj": "cart_a",
          "property": "velocity.x"
        },
        {
          "label": "Cart B Velocity X",
          "color": "#4ecdc4",
          "targetObj": "cart_b",
          "property": "velocity.x"
        }
      ]
    },
    {
      "type": "line",
      "title": "Horizontal Position vs Time",
      "yAxisRange": {
        "min": -5,
        "max": 40
      },
      "yAxisLabel": "Position X (m)",
      "lines": [
        {
          "label": "Cart A Position X",
          "color": "#ff6bff",
          "targetObj": "cart_a",
          "property": "position.x"
        },
        {
          "label": "Cart B Position X",
          "color": "#4ecdc4",
          "targetObj": "cart_b",
          "property": "position.x"
        }
      ]
    }
  ]
}