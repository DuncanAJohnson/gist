{
  "title": "Launched Ball into Sliding Cup",
  "description": "Launch a ball at an angle so it lands in a cup that can slide along the floor. Explore how launch speed, angle, and the cup's motion affect whether the ball is caught.",
  "environment": {
    "walls": ["bottom"],
    "gravity": 9.8,
    "unit": "m",
    "physicsEngine": "rapier",
    "pixelsPerUnit": 14.814814814814815
  },
  "objects": [
    {
      "id": "ball",
      "x": 5.4,
      "y": 8.1,
      "width": 1.8,
      "height": 1.8,
      "svg": "baseball",
      "velocity": { "magnitude": 15, "angle": 45 },
      "mass": 0.15,
      "restitution": 0.8,
      "friction": 0.2,
      "showVectors": ["velocity", "acceleration"]
    },
    {
      "id": "cup",
      "x": 38,
      "y": 0,
      "container": { "innerWidth": 4.0, "wallHeight": 4.0 },
      "mass": 3,
      "friction": 0.12,
      "restitution": 0.1,
      "velocity": { "x": 0, "y": 0 }
    }
  ],
  "controls": [
    {
      "type": "slider",
      "label": "Initial Speed (m/s)",
      "targetObj": "ball",
      "property": "velocity.magnitude",
      "min": 0,
      "max": 30,
      "step": 0.1,
      "defaultValue": 15
    },
    {
      "type": "slider",
      "label": "Launch Angle (deg)",
      "targetObj": "ball",
      "property": "velocity.angle",
      "min": 0,
      "max": 90,
      "step": 0.5,
      "defaultValue": 45
    },
    {
      "type": "slider",
      "label": "Cup Initial Horizontal Velocity (m/s)",
      "targetObj": "cup",
      "property": "velocity.x",
      "min": -30,
      "max": 30,
      "step": 0.1,
      "defaultValue": 0
    }
  ],
  "outputs": [
    {
      "title": "Live readings",
      "values": [
        { "label": "Ball speed", "targetObj": "ball", "property": "velocity.magnitude", "unit": "m/s" },
        { "label": "Ball X position", "targetObj": "ball", "property": "position.x", "unit": "m" },
        { "label": "Ball Y position", "targetObj": "ball", "property": "position.y", "unit": "m" },
        { "label": "Cup horizontal velocity", "targetObj": "cup", "property": "velocity.x", "unit": "m/s" }
      ]
    }
  ],
  "graphs": [
    {
      "type": "line",
      "title": "Ball Height vs Time",
      "yAxisRange": { "min": 0, "max": 16 },
      "yAxisLabel": "Height (m)",
      "lines": [
        { "label": "Ball Height", "color": "#ff6bff", "targetObj": "ball", "property": "position.y" }
      ]
    },
    {
      "type": "line",
      "title": "Cup Horizontal Position vs Time",
      "yAxisRange": { "min": 30, "max": 50 },
      "yAxisLabel": "Position X (m)",
      "lines": [
        { "label": "Cup X", "color": "#4ecdc4", "targetObj": "cup", "property": "position.x" }
      ]
    }
  ]
}
