{
  "title": "Applied-Force-2D - Pulling a crate at an angle: authored appliedForce, polar, with strength / angle / mass sliders.",
  "environment": {
    "walls": [
      "left",
      "right",
      "bottom"
    ],
    "gravity": 9.8,
    "unit": "m",
    "angleUnit": "deg",
    "pixelsPerUnit": 100,
    "physicsEngine": "rapier"
  },
  "objects": [
    {
      "id": "block",
      "x": 1,
      "y": 0.2462,
      "width": 0.5,
      "height": 0.5,
      "svg": "ice_block",
      "mass": 5,
      "friction": 0.8,
      "restitution": 0,
      "appliedForce": {
        "magnitude": 35,
        "angle": 0
      },
      "showVectors": [
        "force-applied",
        {
          "kind": "force-applied",
          "components": true
        },
        "force-friction",
        {
          "kind": "force-normal",
          "labelPlacement": "head"
        },
        {
          "kind": "force-gravity",
          "labelPlacement": "tail"
        },
        {
          "kind": "force-net",
          "labelPlacement": "head"
        }
      ]
    }
  ],
  "controls": [
    {
      "type": "slider",
      "label": "Pull strength (N)",
      "targetObj": "block",
      "property": "appliedForce.magnitude",
      "min": 0,
      "max": 60,
      "step": 0.5,
      "defaultValue": 35
    },
    {
      "type": "slider",
      "label": "Pull angle (°)",
      "targetObj": "block",
      "property": "appliedForce.angle",
      "min": -30,
      "max": 60,
      "step": 1,
      "defaultValue": 0
    },
    {
      "type": "slider",
      "label": "Mass (kg)",
      "targetObj": "block",
      "property": "mass",
      "min": 2,
      "max": 20,
      "step": 0.5,
      "defaultValue": 5
    }
  ],
  "outputs": [
    {
      "title": "Pull",
      "values": [
        {
          "label": "Strength",
          "targetObj": "block",
          "property": "appliedForce.magnitude",
          "unit": "N"
        },
        {
          "label": "Angle",
          "targetObj": "block",
          "property": "appliedForce.angle",
          "unit": "°"
        },
        {
          "label": "Horizontal part",
          "targetObj": "block",
          "property": "appliedForce.x",
          "unit": "N"
        }
      ]
    },
    {
      "title": "Crate",
      "values": [
        {
          "label": "Speed",
          "targetObj": "block",
          "property": "velocity.magnitude",
          "unit": "m/s"
        },
        {
          "label": "Acceleration",
          "targetObj": "block",
          "property": "acceleration.x",
          "unit": "m/s²"
        },
        {
          "label": "x",
          "targetObj": "block",
          "property": "position.x",
          "unit": "m"
        }
      ]
    }
  ],
  "graphs": [
    {
      "type": "line",
      "title": "Speed of crate",
      "yAxisRange": {
        "min": 0,
        "max": 6
      },
      "yAxisLabel": "speed (m/s)",
      "lines": [
        {
          "label": "|v|",
          "targetObj": "block",
          "property": "velocity.magnitude",
          "color": "#2ecc71"
        }
      ]
    }
  ]
}
