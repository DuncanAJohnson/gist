{
  "title": "Ball into Cup — Arc & Tip",
  "description": "Phase 0 concave-collider test. An angled, parabolic throw strikes the cup's rim off-center; the dynamic compound cup tips and tumbles — the crowd-pleaser. Tune the launch sliders to land in the cup instead, or move the cup to catch.",
  "environment": {
    "walls": ["bottom"],
    "gravity": 9.8,
    "unit": "m",
    "pixelsPerUnit": 10,
    "physicsEngine": "rapier"
  },
  "objects": [
    {
      "id": "cup",
      "x": 58,
      "y": 4.5,
      "width": 14,
      "height": 11,
      "svg": "cup",
      "mass": 1,
      "restitution": 0.1,
      "friction": 0.5,
      "showVectors": ["velocity"]
    },
    {
      "id": "ball",
      "x": 8,
      "y": 6,
      "width": 3.5,
      "height": 3.5,
      "svg": "baseball",
      "velocity": { "x": 16, "y": 13 },
      "mass": 2,
      "restitution": 0.3,
      "friction": 0.5,
      "showVectors": ["velocity"]
    }
  ],
  "controls": [
    {
      "type": "slider",
      "label": "Launch Speed X",
      "targetObj": "ball",
      "property": "velocity.x",
      "min": 5,
      "max": 25,
      "step": 0.5,
      "defaultValue": 16
    },
    {
      "type": "slider",
      "label": "Launch Speed Y",
      "targetObj": "ball",
      "property": "velocity.y",
      "min": 5,
      "max": 25,
      "step": 0.5,
      "defaultValue": 13
    },
    {
      "type": "slider",
      "label": "Cup Position",
      "targetObj": "cup",
      "property": "position.x",
      "min": 30,
      "max": 72,
      "step": 0.5,
      "defaultValue": 58
    }
  ],
  "outputs": [
    {
      "title": "Ball",
      "values": [
        { "label": "Ball Speed (x)", "targetObj": "ball", "property": "velocity.x", "unit": "m/s" },
        { "label": "Ball Speed (y)", "targetObj": "ball", "property": "velocity.y", "unit": "m/s" }
      ]
    },
    {
      "title": "Cup",
      "values": [
        { "label": "Cup Spin", "targetObj": "cup", "property": "angularVelocity", "unit": "rad/s" },
        { "label": "Cup X", "targetObj": "cup", "property": "position.x", "unit": "m" }
      ]
    }
  ],
  "graphs": [
    {
      "type": "line",
      "title": "Cup Spin Over Time (tumble signature)",
      "yAxisRange": { "min": -10, "max": 10 },
      "yAxisLabel": "Angular velocity (rad/s)",
      "lines": [
        { "label": "Cup ω", "targetObj": "cup", "property": "angularVelocity", "color": "#e74c3c" }
      ]
    }
  ]
}
